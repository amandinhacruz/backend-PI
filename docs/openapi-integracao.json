    "/startups/{id}": {
      "get": {
        "summary": "Detalhe público de empresa aprovada",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Perfil",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "location": {
                      "type": "string"
                    },
                    "segment": {
                      "type": "string"
                    },
                    "stage": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "tone": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Inexistente ou não aprovada",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "integer"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Autenticação obrigatória"
          }
        }
      }
    },
    "/startups/{id}/materiais/{tipo}": {
      "get": {
        "summary": "Baixar material de empresa aprovada",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "tipo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "pitch",
                "canvas"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Arquivo em attachment",
            "content": {
