                    "type": "string"
                  },
                  "website": {
                    "type": "string"
                  },
                  "city": {
                    "type": "string"
                  },
                  "state": {
                    "type": "string"
                  },
                  "foundedYear": {
                    "type": "string"
                  },
                  "profileOwner": {
                    "type": "string"
                  },
                  "segment": {
                    "type": "string"
                  },
                  "stage": {
                    "type": "string"
                  },
                  "summary": {
                    "type": "string"
                  },
                  "problem": {
                    "type": "string"
                  },
                  "competitiveAdvantages": {
                    "type": "string"
                  },
                  "presentationVideo": {
                    "type": "string"
                  },
                  "necessidades": {
                    "type": "string"
                  },
                  "pitch": {
                    "type": "string"
                  },
                  "canvas": {
                    "type": "string"
                  },
                  "minimumTicket": {
                    "oneOf": [
                      {
                        "type": "number",
                        "minimum": 0
                      },
                      {
                        "type": "string",
                        "pattern": "^\\d+(\\.\\d+)?$"
                      }
                    ]
                  },
                  "maximumTicket": {
                    "oneOf": [
                      {
                        "type": "number",
                        "minimum": 0
                      },
                      {
                        "type": "string",
                        "pattern": "^\\d+(\\.\\d+)?$"
                      }
                    ]
                  },
                  "pitchDeck": {
                    "type": "string",
                    "format": "binary"
                  },
                  "businessModelCanvas": {
                    "type": "string",
                    "format": "binary"
                  },
                  "businessCanvas": {
                    "type": "string",
                    "format": "binary"
                  }
                },
                "required": [
                  "email",
                  "password",
                  "name",
                  "segment",
                  "stage",
                  "dataProcessing"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Criado e pendente de aprovação",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer",
                      "format": "int64"
                    },
                    "email": {
                      "type": "string"
                    },
                    "papel": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "PENDENTE"
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Entrada inválida",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "integer"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "E-mail já cadastrado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "integer"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "413": {
            "description": "Arquivo ou requisição excede limite",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "integer"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "description": "Aliases portugueses continuam aceitos; ver INTEGRACAO.md. Campos opcionais devem ser omitidos se vazios. Arquivos PDF/PPT/PPTX até 10 MB cada."
      }
